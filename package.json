{
  "name": "rwa-ms",
  "version": "0.1.0",
  "private": true,
  "description": "RWA.MS business-first trust and transaction network",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
